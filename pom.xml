<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.apache.org/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-report</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>z-report</name>
    <description>AI-driven drag-and-drop reporting platform (dev workspace: z-report-local, merge into z-report repo by owner)</description>

    <!--
      工程约定 (2026-09-22 与产品负责人确认):
      1) 独立自持: 不 parent 引 com.zifang:z-opc, 单独 clone 可编译
      2) 版本权威: spring-boot-dependencies + z-boot-dependencies 双 BOM
      3) 本工作区(z-report-local)为开发落地处, 由负责人决定何时并入 z-report 正式仓
    -->

    <modules>
        <module>z-report-common</module>
        <module>z-report-datasource</module>
        <module>z-report-dataset</module>
        <module>z-report-render</module>
        <module>z-report-book</module>
        <module>z-report-ai</module>
        <module>z-report-web</module>
        <module>z-report-spring-boot-starter</module>
        <module>z-report-bootstrap</module>
    </modules>

    <properties>
        <java.version>1.8</java.version>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>2.7.18</spring-boot.version>
        <z-boot.version>1.0.17</z-boot.version>
        <z-util.version>1.0.13</z-util.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 第三方版本权威 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-dependencies</artifactId>
                <version>${z-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- z-boot 自家 starter 不入 BOM (revision 流水线), 版本在此统一 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-web-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-datasource-starter</artifactId>
                <version>${z-boot.version}</version>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-report-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- z-util (BOM 不管, 版本统一在 z-util.version) -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-util-cache</artifactId>
                <version>${z-util.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-util-parser-csv</artifactId>
                <version>${z-util.version}</version>
            </dependency>
            <!-- 数据源注册/方言/动态查询/内存 SQL 引擎 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-util-jdbc</artifactId>
                <version>${z-util.version}</version>
                <!-- 同 z-util-cache: 排掉 z-util-core 传递的 SLF4J 2.x 桥, 运行栈统一用 z-boot-web-starter 的 log4j2 -->
                <exclusions>
                    <exclusion>
                        <groupId>org.apache.logging.log4j</groupId>
                        <artifactId>log4j-slf4j2-impl</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <!-- 对象整形语言: 二维结果 → 任意高维结构 (RAW 部件); 零传递依赖 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-util-expr-obj</artifactId>
                <version>${z-util.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-report-datasource</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-report-dataset</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-report-render</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-report-book</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-report-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-report-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-report-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
