<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.apache.org/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-report</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>z-report-bootstrap</artifactId>
    <packaging>jar</packaging>
    <name>z-report :: bootstrap (独立服务启动器)</name>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-report-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 版本不写：z-boot-parent 的 pluginManagement 供 spring-boot-maven-plugin
                 ${spring-boot.version}=2.7.18，与本仓迁移前那格逐字节相同（键已删，见仓根 properties）。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
